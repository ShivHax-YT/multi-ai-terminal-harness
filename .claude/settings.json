{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "effortLevel": "high",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "6",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0"
  },
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git worktree list *)",
      "Bash(make check-fast)",
      "Bash(make check)",
      "Bash(make compliance *)",
      "Bash(scripts/ci/compliance-scan.sh *)",
      "Bash(tests/compliance/selftest.sh)",
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo check *)",
      "Bash(pnpm run *)",
      "Bash(swift build *)",
      "Bash(swift test *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git branch -D *)",
      "Bash(git worktree remove *)",
      "Bash(codex exec *)",
      "Bash(curl *)",
      "Bash(npm install *)",
      "Bash(pnpm add *)",
      "Bash(brew install *)"
    ],
    "deny": [
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Read(~/.codex/**)",
      "Read(~/.grok/**)",
      "Read(~/.gemini/**)",
      "Read(~/.kimi-code/**)",
      "Read(~/.kimi/**)",
      "Edit(~/.claude/.credentials.json)",
      "Edit(~/.claude.json)",
      "Edit(~/.codex/**)",
      "Edit(~/.grok/**)",
      "Edit(~/.gemini/**)",
      "Edit(~/.kimi-code/**)",
      "Edit(~/.kimi/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(security find-generic-password *)",
      "Bash(security find-internet-password *)",
      "Bash(security dump-keychain *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Agent(fork)",
      "Agent(Explore)",
      "Agent(general-purpose)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-context.sh",
            "args": []
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-files.sh",
            "args": [],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.sh",
            "args": [],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format-and-scan.sh",
            "args": [],
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-checks.sh",
            "args": [],
            "timeout": 600
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/log-subagent.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
